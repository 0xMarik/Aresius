{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aresius",
  "version": "0.1.0",
  "identifier": "com.aresius",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "splashscreen",
        "title": "",
        "skipTaskbar": false,
        "width": 900,
        "height": 600,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true,
        "decorations": false,
        "resizable": false,
        "url": "splashscreen.html",
        "visible": true,
        "shadow": false
      },
      {
        "label": "main",
        "decorations": false,
        "title": "Aresius",
        "maximized": true,
        "transparent": true,
        "visible": false,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["ares"]
      }
    ]
  }
}
